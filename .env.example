# qltb-service — copy sang .env
# cp .env.example .env
#
# File này chỉ chứa giá trị dev LOCAL. Môi trường khác lấy từ secret của môi
# trường đó, không commit .env.

PORT=3400
NODE_ENV=development

# ── PostgreSQL 16 ──────────────────────────────────────────────
# Hai dạng đều được, DATABASE_URL THẮNG nếu khai cả hai — khai DATABASE_URL
# (ví dụ Neon) là migrate / seed / service đều đi lên đó, KHÔNG phải local,
# dù bộ DB_* bên dưới vẫn còn. `npm run db:setup` chỉ dùng bộ DB_* (local).
# DATABASE_URL=postgresql://user:pass@host:5432/qltb?sslmode=require
DB_HOST=localhost
DB_PORT=5432
DB_USER=qltb
DB_PASS=qltb_dev_2026
DB_NAME=qltb
DATABASE_POOL_MAX=5
# Thời gian chờ lấy kết nối từ pool (kể cả xếp hàng chờ kết nối rảnh)
DATABASE_CONNECT_TIMEOUT_MS=10000

# ── Swagger: mặc định bật ngoài production ─────────────────────
# SWAGGER_ENABLED=true
#
# ── Vercel ─────────────────────────────────────────────────────
# DATABASE_URL = Neon **pooled** (hostname có -pooler) — app runtime.
# DATABASE_MIGRATE_URL = Neon **direct** (không -pooler) — build Production
#   tự chạy `db:migrate`. Thiếu thì migrate dùng DATABASE_URL (DDL có thể lỗi).
# NODE_ENV do Vercel gán production. Muốn /docs trên Vercel: SWAGGER_ENABLED=true.

# ── Seed (npm run db:seed) ─────────────────────────────────────
SEED_ADMIN_USERNAME=admin
# Bỏ trống thì seed sinh mật khẩu ngẫu nhiên và in ra một lần.
SEED_ADMIN_PASSWORD=

# ── Auth ───────────────────────────────────────────────────────
# Access token qua `Authorization: Bearer`, refresh token qua cookie httpOnly.
# Sinh secret: openssl rand -base64 48
JWT_ACCESS_SECRET=doi-gia-tri-nay-toi-thieu-32-ky-tu-ngau-nhien
JWT_ISSUER=qltb-service
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_SECONDS=604800
REFRESH_COOKIE_NAME=qltb_rt
# Dev chạy http://localhost nên phải false; production để true.
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax
REFRESH_COOKIE_PATH=/api/v1/auth
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCK_DURATION_SECONDS=900

# ── Thiết bị ──────────────────────────────────────────────────
# Quá N giờ kể từ lần cuối máy gửi lượt dùng thì coi là offline.
DEVICE_OFFLINE_AFTER_HOURS=24
