# qltb-service — copy sang .env
# cp .env.example .env
#
# File này chỉ chứa giá trị dev LOCAL. Môi trường khác lấy từ secret của môi
# trường đó, không commit .env.

PORT=3400
NODE_ENV=development

# ── PostgreSQL 16 local ────────────────────────────────────────
# Hai dạng đều được, DATABASE_URL thắng nếu khai cả hai.
# `npm run db:setup` (scripts/db-setup.sh) dùng bộ DB_* này để tạo role + database.
# DATABASE_URL=postgresql://qltb:qltb_dev_2026@localhost:5432/qltb
DB_HOST=localhost
DB_PORT=5432
DB_USER=qltb
DB_PASS=qltb_dev_2026
DB_NAME=qltb
DATABASE_POOL_MAX=5
# Thời gian chờ lấy kết nối từ pool (kể cả xếp hàng chờ kết nối rảnh)
DATABASE_CONNECT_TIMEOUT_MS=10000

# ── CORS ───────────────────────────────────────────────────────
# `*` = mở cho mọi origin (dev). Service phản chiếu origin của request thay vì
# trả `*` thô nên vẫn dùng được với cookie. Production liệt kê origin cụ thể,
# ngăn cách bằng dấu phẩy: https://qltb.example.vn,https://admin.example.vn
CORS_ORIGINS=*

# ── Swagger: mặc định bật ngoài production ─────────────────────
# SWAGGER_ENABLED=true
#
# ── Vercel ─────────────────────────────────────────────────────
# DATABASE_URL = Neon **pooled** (hostname có -pooler). Không dùng chuỗi direct.
# CORS_ORIGINS = origin của qltb-web, ví dụ https://qltb-web.vercel.app
#   (lần đầu có thể để * rồi siết sau khi có URL).
# NODE_ENV do Vercel gán production. Muốn /docs trên Vercel: SWAGGER_ENABLED=true.
