# qltb-service — copy sang .env
# cp .env.example .env
#
# File này chỉ chứa giá trị dev LOCAL. Môi trường khác lấy từ secret của môi
# trường đó, không commit .env.

PORT=3400
NODE_ENV=development

# ── PostgreSQL 16 local ────────────────────────────────────────
# Hai dạng đều được, DATABASE_URL thắng nếu khai cả hai.
# Bộ DB_* phải trùng với .env của qltb-workspace (scripts/db-setup.sh dùng nó).
# DATABASE_URL=postgresql://qltb:qltb_dev_2026@localhost:5432/qltb
DB_HOST=localhost
DB_PORT=5432
DB_USER=qltb
DB_PASS=qltb_dev_2026
DB_NAME=qltb
DATABASE_POOL_MAX=5
# Thời gian chờ lấy kết nối từ pool (kể cả xếp hàng chờ kết nối rảnh)
DATABASE_CONNECT_TIMEOUT_MS=10000

# ── CORS ───────────────────────────────────────────────────────
# Liệt kê origin cụ thể (sau này có cookie thì trình duyệt từ chối `*`).
# Nhiều origin thì ngăn cách bằng dấu phẩy.
CORS_ORIGINS=http://localhost:3401

# ── Swagger: mặc định bật ngoài production ─────────────────────
# SWAGGER_ENABLED=true
